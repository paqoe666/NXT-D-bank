# Пример переменных окружения для backend (скопируйте в .env и заполните).
# Сам файл .env в git не попадает — секреты храним только локально и в Render → Environment.

# База данных PostgreSQL (строка подключения целиком)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО задайте на проде свое длинное значение:
# openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Ключи внешних приложений для API v1.
# Формат: имя-приложения:ключ:scope1|scope2 (несколько ключей — через запятую)
#   casino-dena:77914fae...:read         — только чтение (как было раньше)
#   casino-dena-rw:1122ff...:read|write  — чтение + запись (debit/credit)
# Ключи генерируются так: openssl rand -hex 24
NXT_API_KEYS="casino-dena:change-me:read"

# Операции записи (debit/credit) ВЫКЛЮЧЕНЫ, пока не true: даже ключ со scope write
# получает 403 forbidden_scope. Это защита от случайного списания денег.
DBANK_WRITE_ENABLED=false

# Лимит операций записи в минуту, считается ПО КЛЮЧУ (а не по IP)
WRITE_RATE_MAX=20

# Порт (на Render задаётся автоматически)
PORT=5001

# --- Тайминги конвейера переводов ---
# Сколько операция ждёт в статусе pending, затем сколько в processing (в миллисекундах).
# По умолчанию 4000 и 6000. Чтобы переводы были мгновенными, поставьте 0 и 0.
TRANSFER_PENDING_MS=4000
TRANSFER_PROCESSING_MS=6000

# Часовой пояс банка для расчёта границ дня и месяца (в лимитах переводов).
# По умолчанию 180 = UTC+3 (МСК). Значение 0 = UTC.
BANK_UTC_OFFSET_MINUTES=180

# --- Пороги частоты запросов (при 0 = не ограничивать) ---
TRANSFER_RATE_MAX=5
AUTH_RATE_MAX=10
