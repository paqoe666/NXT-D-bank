# Пример переменных окружения для backend (скопируйте в .env и заполните).
# Сам файл .env в git не попадает — секреты храним только локально и в Render → Environment.

# База данных PostgreSQL (строка подключения целиком)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Секрет для подписи JWT. ОБЯЗАТЕЛЬНО задайте на проде свое длинное значение:
# openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Ключи внешних приложений для API v1 (формат: имя-приложения:ключ,второе:ключ)
# openssl rand -hex 24
NXT_API_KEYS="casino-dena:change-me"

# Порт (на Render задаётся автоматически)
PORT=5001
