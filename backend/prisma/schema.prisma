generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  phone     String   @unique
  login     String   @unique
  password  String
  
  // Новые поля для версии 1.0
  role      String   @default("user") // 'user' или 'ceo'
  theme     String   @default("light")
  language  String   @default("ru")

  // Лимиты переводов (в валюте счета). null = лимит не задан
  dailyLimit   Float?
  monthlyLimit Float?
  
  account       Account?
  cards         Card[]
  sentTx        Transaction[] @relation("Sender")
  receivedTx    Transaction[] @relation("Receiver")
  notifications Notification[]
  paymentRequests PaymentRequest[]
  
  createdAt DateTime @default(now())
}

model Account {
  id       String @id @default(uuid())
  balance  Float  @default(0)
  held     Float  @default(0) // зарезервировано под незавершенные операции (pending/processing)
  isBlocked Boolean @default(false) // счет заблокирован: внешние операции запрещены (423)
  currency String @default("RUB") // RUB, USD, EUR
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id          String  @id @default(uuid())
  number      String  @unique
  expiryDate  String
  cvv         String
  ownerName   String
  
  cardName    String  @default("Основной счет") // <--- ВОТ ЭТА НОВАЯ СТРОЧКА
  
  isBlocked   Boolean @default(false)
  designIndex Int     @default(0)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String   @id @default(uuid())
  type          String   // 'transfer' или 'deposit'
  status        String   // 'pending' | 'processing' | 'completed' | 'failed' | 'canceled' | 'refunded'
  amount        Float
  totalDeducted Float    // Итоговая сумма списания (с учетом комиссии)
  currency      String   @default("RUB")
  commission    Float    @default(0)

  failureReason String?   // причина отказа: recipient_not_found, insufficient_funds_on_recipient и т.п.
  processedAt   DateTime? // когда операция завершилась (успешно или нет)
  refundOfId    String?   // id исходной операции, если это возврат средств
  reference     String?   // внешний идентификатор операции (order-1042 и т.п.) — заполняет API v1
  appName       String?   // какое приложение создало операцию через API v1
  balanceAfter  Float?    // остаток после операции (major-единицы), заполняет API v1
  
  senderId      String?
  sender        User?    @relation("Sender", fields: [senderId], references: [id])
  
  receiverId    String?
  receiver      User?    @relation("Receiver", fields: [receiverId], references: [id])
  
  target        String?  // Указанный при переводе номер (телефона или карты)
  comment       String?
  
  createdAt     DateTime @default(now())
}

model Notification {
  id            String   @id @default(uuid())
  message       String
  type          String   @default("info")
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  userId        String
  transactionId String?  // <-- ДОБАВИЛИ ЭТУ СТРОКУ
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Запрос денег по ссылке/QR: «скинь 500 ₽ на кофе».
// Ссылку можно разослать, по ней платят один или несколько раз.
model PaymentRequest {
  id         String   @id @default(uuid())
  token      String   @unique   // публичный токен из ссылки (случайный, не перебирается)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount     Float?            // null = «сколько угодно» (свободная сумма)
  currency   String   @default("RUB")
  title      String?           // назначение платежа
  status     String   @default("active")  // 'active' | 'paid' | 'canceled'

  paidCount  Int      @default(0)  // сколько раз оплатили
  paidAmount Float    @default(0)  // сколько всего собрано (в валюте запроса)

  expiresAt  DateTime?          // необязательный срок действия
  createdAt  DateTime @default(now())
}

// Идемпотентность операций API v1: повтор с тем же ключом возвращает тот же ответ
model IdempotencyRecord {
  id            String   @id @default(uuid())
  key           String              // значение заголовка Idempotency-Key от клиента
  appName       String              // приложение, выполнившее запрос (ключ уникален в пределах приложения)
  operation     String              // 'debit' | 'credit'
  userId        String
  bodyHash      String              // sha256 канонизированного тела запроса
  amountMinor   Int
  currency      String
  responseJson  String?             // сохранённый ответ для повторного возврата
  transactionId String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime            // минимум 24 часа с момента создания

  @@unique([appName, key])
  @@index([expiresAt])
}

// Аудит операций API v1: по записи на каждое обращение (успех и ошибка)
model ApiAuditLog {
  id          String   @id @default(uuid())
  appName     String?
  keyPrefix   String?  // первые символы ключа (секрет не логируем целиком)
  keyHash     String?  // sha256 ключа
  operation   String
  userId      String?
  txId        String?
  amountMinor Int?
  currency    String?
  direction   String?
  ip          String?
  userAgent   String?
  statusCode  Int
  result      String   // 'applied' | 'replayed' | 'dry_run' | код ошибки
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}